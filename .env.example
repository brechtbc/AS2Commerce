# Copy this file to .env and adjust the values (.env is git-ignored).

# API under test. If nothing answers here and START_SERVER_IF_DOWN=true,
# the test run starts src/server.js itself on this port and stops it afterwards.
BASE_URL=http://localhost:3300
START_SERVER_IF_DOWN=true

# Test user (README "Test Data")
USER_EMAIL=alice@example.com
USER_PASSWORD=alice123
